---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import {
  resume,
  contactParts,
  dateRange,
  downloadName,
  plainText,
  richHtml,
  workGroups,
} from "@/utils/resume";

const b = resume.basics;
---

<Layout title={`Resume | ${SITE.title}`} description={plainText(b.summary)}>
  <Header />
  <main id="main-content" class="resume-main">
    <div class="downloads flex flex-wrap justify-end gap-3 text-sm">
      <a class="download" href="/resume.pdf" download={downloadName("pdf")}>
        Download PDF
      </a>
      <a class="download" href="/resume.md" download={downloadName("md")}>
        Download Markdown
      </a>
    </div>

    <article class="resume mb-28">
      <h1 class="name">{b.name}</h1>
      <p class="contact">
        {contactParts().map((c, i) => (
          <>
            {i > 0 && " | "}
            {c.href ? <a href={c.href}>{c.text}</a> : c.text}
          </>
        ))}
      </p>

      <section>
        <h2>Summary</h2>
        <p set:html={richHtml(b.summary)} />
      </section>

      <section>
        <h2>Experience</h2>
        {resume.work.map(w => (
          <div class="job">
            <p class="role">
              <span>
                <strong>
                  {w.name} · {w.position}
                </strong>
                {w.location && <span class="muted"> · {w.location}</span>}
              </span>
              <span class="when">{dateRange(w)}</span>
            </p>
            {"summary" in w && w.summary && (
              <p>
                <em set:html={richHtml(w.summary)} />
              </p>
            )}
            {workGroups(w).map(g => (
              <>
                {g.title && (
                  <p>
                    <em>{g.title}</em>
                  </p>
                )}
                <ul>
                  {g.items.map(item => (
                    <li set:html={richHtml(item)} />
                  ))}
                </ul>
              </>
            ))}
          </div>
        ))}
      </section>

      <section>
        <h2>Projects</h2>
        <ul>
          {resume.projects.map(p => (
            <li>
              {p.url ? <a href={p.url}>{p.name}</a> : p.name}
              {` (${p.keywords.join(", ")}): `}
              <Fragment set:html={richHtml(p.description)} />
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Skills</h2>
        <ul>
          {resume.skills.map(s => (
            <li>
              {s.name}: {s.keywords.join(", ")}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Education</h2>
        {resume.education.map(e => (
          <>
            <p class="role edu">
              <span>
                <strong>{e.institution}</strong>
                <span class="muted">
                  {" "}
                  · {e.studyType}, {e.area}
                </span>
              </span>
              <span class="when">
                {e.startDate} – {e.endDate}
              </span>
            </p>
            {"x-note" in e && e["x-note"] && (
              <p>
                <em>{e["x-note"]}</em>
              </p>
            )}
          </>
        ))}
      </section>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* IBM Plex Sans (OFL 1.1), same font as the PDF. Files in public/fonts/. */
  @font-face {
    font-family: "IBM Plex Sans";
    src: url("/fonts/IBMPlexSans-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "IBM Plex Sans";
    src: url("/fonts/IBMPlexSans-Italic.woff2") format("woff2");
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: "IBM Plex Sans";
    src: url("/fonts/IBMPlexSans-SemiBold.woff2") format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "IBM Plex Sans";
    src: url("/fonts/IBMPlexSans-SemiBoldItalic.woff2") format("woff2");
    font-weight: 600;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: "IBM Plex Sans";
    src: url("/fonts/IBMPlexSans-Bold.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "IBM Plex Sans";
    src: url("/fonts/IBMPlexSans-BoldItalic.woff2") format("woff2");
    font-weight: 700;
    font-style: italic;
    font-display: swap;
  }
</style>

<style>
  /* Layout F: pageless, section labels in a left gutter (stacked on phones).
     Same IBM Plex Sans as the PDF; colors come from the site theme. */
  .resume-main {
    margin-inline: auto;
    width: 100%;
    max-width: 56rem;
    padding: 2rem 1rem 5rem;
  }
  .resume {
    margin-top: 0.5rem;
    font-family: "IBM Plex Sans", system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.55;
  }
  .resume :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .resume :global(a:hover) {
    color: var(--accent);
  }
  .name {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .contact {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    opacity: 0.8;
  }
  section {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0 2rem;
    margin-top: 2.25rem;
  }
  section > :not(h2) {
    grid-column: 2;
  }
  h2 {
    padding-top: 0.2rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.65;
  }
  p {
    margin: 0.25rem 0;
  }
  .job {
    margin-top: 1.25rem;
  }
  section > .job:first-of-type {
    margin-top: 0;
  }
  .role {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0;
  }
  .edu {
    margin-top: 0.5rem;
  }
  section > .edu:first-of-type {
    margin-top: 0;
  }
  .muted,
  .when {
    opacity: 0.65;
  }
  .when {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.25rem 0 0.5rem;
  }
  li {
    margin: 0.25rem 0;
  }
  li::marker {
    color: color-mix(in srgb, currentColor 45%, transparent);
  }
  .download {
    border: 1px solid currentColor;
    border-radius: 0.375rem;
    padding: 0.35rem 0.85rem;
  }
  .download:hover {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .resume-main {
      padding-top: 1.25rem;
    }
    .downloads {
      justify-content: flex-start;
    }
    .name {
      font-size: 1.875rem;
    }
    section {
      display: block;
      margin-top: 1.75rem;
    }
    h2 {
      margin-bottom: 0.5rem;
    }
  }
  @media print {
    @page {
      size: letter;
      margin: 0.5in;
    }
    :global(#main-content ~ footer),
    :global(header),
    :global(footer),
    .downloads {
      display: none !important;
    }
    .resume-main {
      max-width: none;
      padding: 0;
    }
    .resume {
      font-size: 10.5pt;
      color: #000;
    }
    .job {
      break-inside: avoid;
    }
  }
</style>
