{
  "name": "blog",
  "type": "module",
  "version": "5.5.1",
  "scripts": {
    "dev": "node scripts/fetch-fonts.mjs && astro dev",
    "fonts": "node scripts/fetch-fonts.mjs",
    "build": "node scripts/fetch-fonts.mjs && astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "resume:pdf": "node scripts/fetch-fonts.mjs && typst compile --ignore-system-fonts --font-path resume/fonts resume/resume.typ public/resume.pdf",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^5.18.2",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.18.4",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@pagefind/default-ui": "^1.6.0",
    "@shikijs/transformers": "^3.23.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "pnpm@10.11.1"
}
